[Unit]
Description=Raspberry Pi Temperature and Humidity Monitor
After=multi-user.target

[Service]
User=pi
WorkingDirectory=/home/pi/file/RaspberryPI-THSensor
ExecStart=/home/pi/file/RaspberryPI-THSensor/ENV/bin/python3 /home/pi/file/RaspberryPI-THSensor/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target